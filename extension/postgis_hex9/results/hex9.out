-- ── Sphere-datum twins (2.1.0) ───────────────────────────────────────────────
-- The *_sphere functions run the identical chain minus the WGS84 authalic
-- reduction. Datum doctrine: docs/warp-regimes.md, "Two datums, one regime".
-- At the equator the reduction is exactly identity: bit-identical address.
SELECT h9_encode_sphere(ST_SetSRID(ST_MakePoint(17.25, 0.0), 0)) =
       h9_encode       (ST_SetSRID(ST_MakePoint(17.25, 0.0), 4326))
           AS sphere_equator_identity;
 sphere_equator_identity 
-------------------------
 t
(1 row)

-- Same numerics, different datum: addresses diverge at mid-latitude…
SELECT h9_encode_sphere(ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)) <>
       h9_encode       (ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 4326))
           AS sphere_diverges_mid_lat;
 sphere_diverges_mid_lat 
-------------------------
 t
(1 row)

-- …but only below the coarse layers (max authalic shift ~21 km, L2 ~300 km).
SELECT h9_bin(h9_encode_sphere(ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)), 2) =
       h9_bin(h9_encode       (ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 4326)), 2)
           AS sphere_l2_bins_agree;
 sphere_l2_bins_agree 
----------------------
 t
(1 row)

-- Sphere decode: SRID 0 (spherical degrees have no EPSG identity; the datum
-- is dataset metadata), and the round-trip returns the point (planar degrees
-- — geography is meaningless without a datum).
SELECT ST_SRID(h9_decode_sphere(h9_encode_sphere(
           ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)))) AS sphere_srid;
 sphere_srid 
-------------
           0
(1 row)

SELECT ST_Distance(
           ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0),
           h9_decode_sphere(h9_encode_sphere(
               ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)))
       ) < 1e-6 AS sphere_roundtrip_sub_udeg;
 sphere_roundtrip_sub_udeg 
---------------------------
 t
(1 row)

-- Sphere cell polygon: SRID 0, 7-point closed ring, contains its own
-- decoded centroid (planar test — both sides SRID 0).
WITH c AS (
    SELECT h9_bin(h9_encode_sphere(
               ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)), 8) AS b,
           h9_encode_sphere(
               ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0)) AS u
)
SELECT ST_SRID(h9_cell_sphere(b, 8))    = 0 AS sphere_cell_srid,
       ST_NPoints(h9_cell_sphere(b, 8)) = 7 AS sphere_cell_ring7,
       ST_Contains(h9_cell_sphere(b, 8),
                   ST_SetSRID(ST_MakePoint(-0.1276, 51.5074), 0))
                                            AS sphere_cell_contains_point
FROM c;
 sphere_cell_srid | sphere_cell_ring7 | sphere_cell_contains_point 
------------------+-------------------+----------------------------
 t                | t                 | t
(1 row)

-- Sphere grid: enumerates, emits SRID 0, and is bin-coherent in its own
-- datum (every centroid re-encodes into its own cell). Same numeric bbox
-- under the WGS84 grid gives a different cell set.
WITH gs AS (
    SELECT * FROM h9_grid_sphere(
        ST_MakeEnvelope(-0.3, 51.3, 0.1, 51.7, 0), 8)
)
SELECT count(*) > 0                                   AS sphere_grid_nonempty,
       bool_and(ST_SRID(geom) = 0)                    AS sphere_grid_srid0,
       bool_and(ST_SRID(centroid) = 0)                AS sphere_grid_centroid_srid0,
       bool_and(h9_bin = h9_bin(h9_encode_sphere(centroid), 8))
                                                      AS sphere_grid_bin_coherent
FROM gs;
 sphere_grid_nonempty | sphere_grid_srid0 | sphere_grid_centroid_srid0 | sphere_grid_bin_coherent 
----------------------+-------------------+----------------------------+--------------------------
 t                    | t                 | t                          | t
(1 row)

SELECT EXISTS (
           SELECT h9_bin FROM h9_grid_sphere(
               ST_MakeEnvelope(-0.3, 51.3, 0.1, 51.7, 0), 8)
           EXCEPT
           SELECT h9_bin FROM h9_grid(
               ST_MakeEnvelope(-0.3, 51.3, 0.1, 51.7, 4326), 8)
       ) AS sphere_grid_differs_from_wgs84;
 sphere_grid_differs_from_wgs84 
--------------------------------
 t
(1 row)

-- ── h9_adaptive_sphere (2.1.0): same digest, sphere rendering ────────────────
-- The digest is symbolic (addresses in/out), so h9_bin/layer/value/npoints/
-- grade are IDENTICAL to h9_adaptive on the same input; only geom (spherical,
-- SRID 0) and density (per STERADIAN, intrinsic to the unit sphere) differ.
WITH pts AS (
    SELECT array_agg(h9_encode_sphere(
               ST_SetSRID(ST_MakePoint(lon, lat), 0))) AS u
    FROM (VALUES (-0.1276, 51.5074), (-0.1280, 51.5070),
                 (-3.1900, 55.9500), (17.2500, 0.0)) AS v(lon, lat)
),
a  AS (SELECT * FROM pts, LATERAL h9_adaptive(u, NULL, 2, 6, 2.0, 1.0)),
s  AS (SELECT * FROM pts, LATERAL h9_adaptive_sphere(u, NULL, 2, 6, 2.0, 1.0))
SELECT (SELECT array_agg(h9_bin ORDER BY h9_bin) FROM a) =
       (SELECT array_agg(h9_bin ORDER BY h9_bin) FROM s)   AS adaptive_digest_identical,
       (SELECT sum(value) FROM s) = 4.0                    AS adaptive_weight_conserved,
       (SELECT bool_and(ST_SRID(geom) = 0) FROM s)         AS adaptive_sphere_srid0,
       (SELECT bool_and(abs(density - value * 12.0 * 9.0 ^ layer / (4.0 * pi()))
                        < 1e-12 * density) FROM s)         AS adaptive_density_per_sr;
 adaptive_digest_identical | adaptive_weight_conserved | adaptive_sphere_srid0 | adaptive_density_per_sr 
---------------------------+---------------------------+-----------------------+-------------------------
 t                         | t                         | t                     | t
(1 row)

-- ═══ E4H: the aperture-4 structural tail (2.3.0) ════════════════════════════
-- Pinned mint — universality: the same point mints these exact bytes on
-- every platform (cf. libhex9 test_data/e4h_pin.tsv and wheel_pin.py).
SELECT h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326), 6, 4) AS e4h_uuid,
       h9e_label(h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326), 6, 4)) AS e4h_label;
               e4h_uuid               |   e4h_label   
--------------------------------------+---------------
 4321774e-0150-5fff-ffff-fffffffffff3 | 4321774E01505
(1 row)

-- Structural laws: marker, depth, label round-trip, truncation-is-binning,
-- host recovery, decode-lands-near.
WITH e AS (
    SELECT ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326) AS pt,
           h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326), 6, 4) AS u
)
SELECT h9_is_e4h(u)                                    AS is_e4h,
       NOT h9_is_e4h(h9_encode(pt))                    AS h9_is_not_e4h,
       h9e_depth(u) = 4                                AS depth_4,
       h9e_parse_label(h9e_label(u)) = u               AS label_roundtrip,
       h9e_bin(u, 2) = h9e_encode(pt, 6, 2)            AS truncation_is_binning,
       h9e_host(u) = h9_bin(h9_encode(pt), 6)          AS host_is_the_l6_bin,
       ST_Distance(h9e_decode(u)::geography,
                   pt::geography) < 500.0              AS decode_lands_near
FROM e;
 is_e4h | h9_is_not_e4h | depth_4 | label_roundtrip | truncation_is_binning | host_is_the_l6_bin | decode_lands_near 
--------+---------------+---------+-----------------+-----------------------+--------------------+-------------------
 t      | t             | t       | t               | t                     | t                  | t
(1 row)

-- Matched pairs: the partner half shares the final digit and the
-- partner-of-partner is the original address (involution).
WITH e AS (SELECT h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326),
                             6, 4) AS u),
     p AS (SELECT u, h9e_encode(h9e_partner(u), 6, 4) AS v FROM e)
SELECT v <> u                                           AS partner_differs,
       right(h9e_label(v), 1) = right(h9e_label(u), 1)  AS shared_final_digit,
       h9e_encode(h9e_partner(v), 6, 4) = u             AS partner_involution
FROM p;
 partner_differs | shared_final_digit | partner_involution 
-----------------+--------------------+--------------------
 t               | t                  | t
(1 row)

-- Sphere twin mints its own (different) E4H address for the same numerics.
WITH s AS (
    SELECT h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326), 6, 4) AS w,
           h9e_encode_sphere(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 0), 6, 4) AS u
)
SELECT h9_is_e4h(u) AS sphere_mints_e4h, u <> w AS sphere_differs FROM s;
 sphere_mints_e4h | sphere_differs 
------------------+----------------
 t                | t
(1 row)

-- The 0xE marker guard: h9 machinery must reject E4H input loudly.
SELECT h9_bin(h9e_encode(ST_SetSRID(ST_MakePoint(-3.19, 55.95), 4326), 6, 2), 4);
ERROR:  h9_bin: could not bin UUID at layer 4
-- ═══ Grid verbs: h9_aim / h9_walk_to / h9_vision_cone (2.3.0) ═══════════════
-- Cell-first (bin keys in and out); field straddles the equator octant seam.
WITH f AS (
    SELECT ST_SetSRID(ST_MakePoint(35.02, -0.02), 4326) AS pt,
           h9_bin(h9_encode(ST_SetSRID(ST_MakePoint(35.02, -0.02), 4326)), 8) AS fox
)
SELECT h9_aim(fox, 8, 15.0) <> fox                                 AS aim_moves,
       (SELECT count(*) FROM h9_vision_cone(fox, 8, 15.0, 32.0, 3)) > 1
                                                                   AS cone_nonempty,
       (SELECT count(*) FROM h9_vision_cone(fox, 8, 0.0, 180.0, 3)) =
       (SELECT count(*) FROM h9_kdisk(h9_encode(pt), 8, 3))        AS full_cone_is_disk,
       fox IN (SELECT v FROM h9_vision_cone(fox, 8, 15.0, 32.0, 3) v)
                                                                   AS src_always_visible,
       (SELECT bool_or(clat.l > 0.0) AND bool_or(clat.l < 0.0)
        FROM h9_vision_cone(fox, 8, 15.0, 32.0, 3) v,
             LATERAL (SELECT ST_Y(h9_decode(v)) AS l) clat)        AS cone_crosses_seam,
       h9_walk_to(fox, fox, 8) = ARRAY[fox]                        AS walk_to_self,
       h9_walk_to(fox, h9_aim(fox, 8, 15.0), 8)
           = ARRAY[fox, h9_aim(fox, 8, 15.0)]                      AS walk_one_step
FROM f;
 aim_moves | cone_nonempty | full_cone_is_disk | src_always_visible | cone_crosses_seam | walk_to_self | walk_one_step 
-----------+---------------+-------------------+--------------------+-------------------+--------------+---------------
 t         | t             | t                 | t                  | t                 | t            | t
(1 row)

-- Walk laws: endpoints, an obstacle forces a different path that avoids it;
-- occlusion: the cell straight behind a blocker falls into shadow while the
-- blocker's own face stays visible.
WITH f AS (
    SELECT h9_bin(h9_encode(ST_SetSRID(ST_MakePoint(35.02, -0.02), 4326)), 8) AS fox
),
c AS (
    SELECT fox,
           h9_aim(fox, 8, 15.0)                              AS a1,
           h9_aim(h9_aim(fox, 8, 15.0), 8, 15.0)             AS a2,
           h9_aim(h9_aim(h9_aim(fox, 8, 15.0), 8, 15.0), 8, 15.0) AS a3
    FROM f
),
w0 AS (SELECT c.*, h9_walk_to(fox, a3, 8) AS path FROM c),
w AS (SELECT w0.*, h9_walk_to(fox, a3, 8, ARRAY[path[2]]) AS detour FROM w0)
SELECT array_length(path, 1) >= 3                        AS walk_len_ge_3,
       path[1] = fox AND path[array_length(path, 1)] = a3 AS walk_endpoints,
       NOT (path[2] = ANY (detour))                      AS detour_avoids_obstacle,
       detour[array_length(detour, 1)] = a3              AS detour_reaches_dest,
       a1 IN (SELECT v FROM h9_vision_cone(fox, 8, 15.0, 32.0, 3, ARRAY[a1]) v)
                                                         AS blocker_face_visible,
       NOT (a2 IN (SELECT v FROM h9_vision_cone(fox, 8, 15.0, 32.0, 3, ARRAY[a1]) v))
                                                         AS behind_blocker_shadowed
FROM w;
 walk_len_ge_3 | walk_endpoints | detour_avoids_obstacle | detour_reaches_dest | blocker_face_visible | behind_blocker_shadowed 
---------------+----------------+------------------------+---------------------+----------------------+-------------------------
 t             | t              | t                      | t                   | t                    | t
(1 row)

-- Verbs reject E4H input (the marker guard).
SELECT h9_aim(h9e_encode(ST_SetSRID(ST_MakePoint(35.02, -0.02), 4326), 6, 2), 8, 0.0);
ERROR:  h9_aim: not a valid H9 key at layer 8 (or non-finite bearing)
-- True-bearing correction: roundtrip, cardinal/pole identity, magnitude.
SELECT abs(h9_bearing_to_true(h9_bearing_from_true(137.0, 55.95), 55.95) - 137.0) < 1e-9
                                                          AS bearing_roundtrip,
       h9_bearing_from_true(90.0, 45.0) = 90.0            AS cardinal_identity,
       abs(h9_bearing_from_true(45.0, 90.0) - 45.0) < 1e-9 AS pole_identity,
       abs(45.0 - h9_bearing_from_true(45.0, 0.0) - 0.1918) < 1e-3
                                                          AS flattening_magnitude;
 bearing_roundtrip | cardinal_identity | pole_identity | flattening_magnitude 
-------------------+-------------------+---------------+----------------------
 t                 | t                 | t             | t
(1 row)

