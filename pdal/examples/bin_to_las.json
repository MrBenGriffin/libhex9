[
  {
    "type": "readers.las",
    "filename": "input.laz"
  },
  {
    "type": "filters.reprojection",
    "in_srs": "EPSG:27700",
    "out_srs": "EPSG:4326"
  },
  {
    "type": "filters.hex9bin",
    "min_layer": 11,
    "max_layer": 11,
    "ceiling": 1000000,
    "floor": 1,
    "aggregates": "Z:mean,Z:min,Z:max,Classification:mode,Intensity:mean"
  },
  {
    "type": "writers.las",
    "filename": "hex9_cells.las",
    "minor_version": 4,
    "extra_dims": "all",
    "scale_x": 0.0000001,
    "scale_y": 0.0000001,
    "scale_z": 0.001,
    "offset_x": "auto",
    "offset_y": "auto",
    "offset_z": "auto"
  }
]
